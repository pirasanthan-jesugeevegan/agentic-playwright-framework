{
  "name": "agentic-playwright-framework",
  "version": "1.0.0",
  "packageManager": "pnpm@11.23.0",
  "description": "Agent-authored Playwright + TypeScript E2E suite for automationexercise.com, with coding standards mechanically enforced pre-commit.",
  "keywords": [
    "playwright",
    "typescript",
    "e2e-testing",
    "page-object-model",
    "ai-agent"
  ],
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm lint && pnpm format:check && pnpm typecheck",
    "prepare": "husky",
    "test:smoke": "playwright test --grep @smoke",
    "test:vr": "playwright test --project=visual-regression",
    "test:vr:update": "playwright test --project=visual-regression --update-snapshots",
    "report:allure:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "report:allure:open": "allure open ./allure-report",
    "test:scripts": "node --test scripts/qa-showcase/*.test.mjs scripts/agent-evals/*.test.mjs scripts/docs-drift/*.test.mjs",
    "check:status": "node scripts/docs-drift/check-status-drift.mjs",
    "test:agent-evals": "node scripts/agent-evals/run-eval.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pirasanthan-jesugeevegan/agentic-playwright-framework.git"
  },
  "author": "Pirasanthan Jesugeevegan",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pirasanthan-jesugeevegan/agentic-playwright-framework/issues"
  },
  "homepage": "https://github.com/pirasanthan-jesugeevegan/agentic-playwright-framework#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.1",
    "allure-commandline": "^2.30.0",
    "allure-playwright": "3.12.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "zod": "^4.6.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0"
  }
}
